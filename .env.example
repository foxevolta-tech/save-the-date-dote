# Copiez ce fichier en ".env" (local) ou renseignez ces variables
# dans Vercel > Project Settings > Environment Variables.

# Mot de passe pour la page /admin (statistiques + recherche d'invites)
ADMIN_PASSWORD=change-moi

# Mot de passe pour la page /scan (donne aux personnes qui controlent l'entree)
SCAN_PASSWORD=change-moi-aussi

# URL publique du site, utilisee pour generer le contenu des QR codes
# (ex: https://mon-mariage.vercel.app). En local, laissez tel quel.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Stockage persistant (recommande pour un deploiement Vercel) ---
# Sans ces deux variables, l'application utilise un simple fichier JSON
# (data/guests.json). Cela fonctionne tres bien en local ou sur un serveur
# classique, mais NE PERSISTE PAS de maniere fiable sur Vercel, car les
# fonctions serverless n'ont pas de disque partage entre les invocations.
#
# Pour un controle d'entree fiable le jour J avec plusieurs telephones qui
# scannent en meme temps, creez une base Upstash Redis gratuite
# (https://vercel.com/marketplace/upstash ou https://upstash.com) et collez
# ici les identifiants REST fournis :
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
